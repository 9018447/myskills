[tool] $ node --input-type=module -e '
import { readdirSync, statSync, existsSync, join } from "node:fs";
const root = "/home/smh/myskills";
const isSkillDir = (d) => { try { return statSync(d).isDirectory() && existsSync(join(d, "SKILL.md")); } catch { return false; } };
const containsSkill = (d) => { for (const e of readdirSync(d, {withFileTypes:true})) { if (isSkillDir(join(d,e.name))) return true; if (e.isDirectory() && containsSkill(join(d,e.name))) return true; } return false; };
const EXEMPT = new Set(["manager","machines","testdir","presets"]);
const manifest = JSON.parse((await import("node:fs")).readFileSync(join(root,"skills-manifest.json"),"utf8"));
// JSON preset members existence check
let missing = [];
for (const [p, ms] of Object.entries(manifest.presets ?? {})) for (const m of ms) { if (!isSkillDir(join(root,m))) missing.push(p+"/"+m); }
console.log("JSON presets:", Object.keys(manifest.presets??{}).length, "missing members:", JSON.stringify(missing));
console.log("presetApplied keys:", JSON.stringify(Object.keys(manifest.presetApplied??{})));
// collection candidates
let cols = [], other = [];
for (const e of readdirSync(root, {withFileTypes:true})) {
  if (e.name.startsWith(".") || EXEMPT.has(e.name) || !e.isDirectory() || e.isSymbolicLink()) continue;
  const abs = join(root, e.name);
  const real = statSync(abs).isDirectory();
  if (!real) continue;
  if (isSkillDir(abs)) continue;
  if (containsSkill(abs)) cols.push(e.name); else other.push(e.name);
}
console.log("collections to move:", JSON.stringify(cols));
console.log("non-skill, no-subskill top dirs (stay):", JSON.stringify(other));
