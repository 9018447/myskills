# aider 的 .env 示例。复制到仓库根目录、改名 .env、填入真实值。
# aider 默认读 git 仓库根目录的 .env（也可用 --env-file <路径> 指定别的位置）。
# 注意：.env 含密钥，务必加进 .gitignore，不要提交。

# ---- Anthropic 兼容网关（litellm 的 anthropic provider 认这两个）----
# 网关地址（aider 会向 <BASE_URL>/v1/messages 发请求）
ANTHROPIC_API_BASE=https://your-gateway.example.com
# 网关 API 密钥
ANTHROPIC_API_KEY=sk-xxxxxxxx

# ---- aider 自身配置（任意 aider 选项都能用 AIDER_ 前缀的环境变量设置）----
# 模型名；自建网关给 Claude Code 用的模型名可从 ~/.claude/settings.json 的 ANTHROPIC_MODEL 抄
AIDER_MODEL=anthropic/glm-5.3-flash[1m]
# 等价于命令行 --yes-always
#AIDER_YES_ALWAYS=true
